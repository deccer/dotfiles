[core]
    compression = 9
    preloadindex = true
    fsync = none  

[blame]
    coloring = highlightRecent

[init]
    defaultBranch = dev

[status]
    branch = true
    short = true
    showStash = true
    showUntrackedFiles = all

[pager]
    branch = false
    tag = false
    diff = diff-so-fancy | $PAGER
