[core]
    compression = 9
    preloadindex = true
    fsync = none  

[transfer]
    fsckObjects = true

[receive]
    fsckObjects = true

[fetch]
    fsckObjects = true

[blame]
    coloring = highlightRecent

[init]
    defaultBranch = dev

[status]
    branch = true
    short = true
    showStash = true
    showUntrackedFiles = all

[pager]
    branch = false
    tag = false
    diff = diff-so-fancy | $PAGER

[push]
    autoSetupRemote = true
    default = current
    followTags = true

[pull]
    rebase = true
    default = current

[submodule]
    fetchJobs = 16

[rebase]
    autoStash = true
    missingCommitsCheck = warn

[pack]
    threads = 0
    windowMemory = 1g
    packSizeLimit = 1g

[branch]
    sort = -committerdate

[tag]
    sort = -taggerdate
